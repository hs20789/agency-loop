# 예시 파일입니다. 이 파일은 고치지 말고 `cp .env.example .env`로 복사한 .env에 값을 넣습니다(.env는 git에서 제외됨).
# 앱은 .env를 직접 읽지 않으니 실행 전에 셸로 불러옵니다: set -a; . ./.env; set +a; .venv/bin/python -m agency_loop
# 키는 이 예시 파일이나 문서·대화에 적지 않습니다.
# ANTHROPIC_API_KEY=
# CLOVA_API_KEY=
# MISTRAL_API_KEY=

# 제공자 모드: mock(기본) | live | off
AGENCY_ANTHROPIC_MODE=mock
AGENCY_CLOVA_MODE=mock
AGENCY_MISTRAL_MODE=mock
AGENCY_EMBED_MODE=mock
AGENCY_LOCAL_LLM_MODE=mock

# 웹 서버(배포 시 0.0.0.0, 허용 Host에 공인 IP:8000 추가)
AGENCY_HOST=127.0.0.1
AGENCY_PORT=8000
AGENCY_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000

# 수업 서버 주소(공인 IP, 평문 HTTP)
AGENCY_OLLAMA_EMBED_URL=
AGENCY_OLLAMA_CHAT_URL=
# 수업 Local LLM MCP가 HTTP로 떠 있으면 그 주소(예: http://<local-llm-chat 공인 IP>:9001/mcp). 비우면 stdio 명령을 씁니다.
# HTTP 방식에서는 요약 모델을 MCP 서버 쪽 설정이 정합니다(AGENCY_LOCAL_LLM_MODEL은 쓰이지 않음).
AGENCY_MCP_URL=
